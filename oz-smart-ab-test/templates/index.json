    "accordion_97Hpey": {
      "type": "accordion",
      "blocks": {
        "accor_item_7TJQ4x": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "What does UPF 50+ mean and why does it matter?",
            "content": "<p>UPF 50+ means the fabric blocks at least 98% of UV radiation, which helps limit how much reaches your skin while you’re outside. Given how strong the sun is here in Australia, it’s a rating that just makes sense for daily wear.</p>"
          }
        },
        "accor_item_GpPJNq": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "Is OZ Smart an Australian-owned company?",
            "content": "<p>Yes, we are! OZ Smart is proudly Australian-owned, with roots in Queensland and a strong connection to outdoor life.</p>"
          }
        },
        "accor_item_6Ax6RY": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "Do you offer free shipping within Australia?",
            "content": "<p>Free shipping is available on all orders over $59 within Australia, with orders sent out quickly from our Sydney and Melbourne warehouses.</p>"
          }
        },
        "accor_item_PGHjHz": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "What types of sun hats does OZ Smart sell?",
            "content": "<p>We offer a range of sun protection hats for different activities and preferences. This includes wide brim styles and neck flap hats, along with options designed for extra coverage.</p>"
          }
        },
        "accor_item_QeCDbU": {
          "type": "accor_item",
          "settings": {
            "icon": "none",
            "title": "How do I choose the right sun hat for my needs?",
            "content": "<p>Choosing the right UPF 50 hats comes down to how and where you spend time outside. Follow these tips:</p><ul><li>Go for a wide brim if you want more coverage across your face and neck</li><li>Choose a lighter fabric for long days in the heat</li><li>Look for adjustable fits and chin straps to keep the hat secure in windy conditions</li></ul>"
          }
        }
      },
